# Database (SQLite - no external database needed!)
DATABASE_URL=./data/inboxgpt.db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# Encryption Key (32 bytes hex encoded for AES-256)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gmail OAuth (optional - for one-click Gmail connect)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook OAuth (optional - for one-click Outlook connect)
# Get from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# AI Providers (at least one required for AI features)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: AI Model Settings
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022
