# ---- Database (Postgres + pgvector; `docker compose up -d postgres`) ----
DATABASE_URL=postgres://inboxgpt:inboxgpt@localhost:5432/inboxgpt
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---- NextAuth ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production
AUTH_ALLOW_PASSWORD=false

# ---- Encryption (32 bytes hex; generate with: openssl rand -hex 32) ----
# APP_KEK wraps per-workspace DEKs stored in workspaces.dek_wrapped.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- Google OAuth (primary sign-in + Gmail zero-click) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft OAuth (Outlook sign-in + Mail.ReadWrite) ----
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ---- AI Providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022
# text-embedding-3-small → vector(1536) in messages.embedding
AI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Twilio (SMS/MMS + Voice/voicemail) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_AUTH_TOKEN=

# ---- Slack ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---- Discord ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# ---- Meta (Tier 2 — behind feature flag) ----
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ---- X / Twitter (Tier 2 — Enterprise tier required for DM webhooks) ----
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# ---- LinkedIn (Tier 2 — Partner Program) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---- Rate limiting (optional, falls back to in-memory) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Email outbound (invites) ----
RESEND_API_KEY=
INVITE_FROM_EMAIL=no-reply@inboxgpt.local

# ---- Quote-request notification email (STR-67) ----
# Set NOTIFICATION_SMTP_HOST to enable alerts on new /pricing quote submissions.
# Leads are always saved to the DB; email is a graceful no-op if unconfigured.
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASS=
NOTIFICATION_EMAIL_TO=james@strickland.tech
NOTIFICATION_EMAIL_FROM="InboxGPT" <noreply@inboxgpt.io>
